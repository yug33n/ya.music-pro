export global Theme {
    // Colors
    in-out property <color> background: #121212;
    in-out property <color> sidebar-background: #181818;
    in-out property <color> card-background: #222222;
    in-out property <color> card-hover: #2a2a2a;
    in-out property <color> player-bar-background: #181818;
    in-out property <color> popup-background: #282828;

    in-out property <color> accent: #FFCC00; // Yandex Yellow
    in-out property <color> accent-hover: #FFD633;
    in-out property <color> accent-pressed: #E6B800;

    in-out property <color> text-primary: #FFFFFF;
    in-out property <color> text-secondary: #8C8C8C;
    in-out property <color> text-muted: #555555;
    in-out property <color> border: #282828;
    in-out property <color> divider: #222222;

    in-out property <color> quality-flac: #6B7CFF;
    in-out property <color> quality-hq: #FFCC00;
    in-out property <color> quality-bitperfect: #00E5FF;
    in-out property <color> like-active: #FF334B;

    // Typography & Metrics
    in-out property <string> font-family-text: "YS Text, Segoe UI, sans-serif";
    in-out property <string> font-family-display: "YS Display, Segoe UI, sans-serif";

    in-out property <length> sidebar-width: 240px;
    in-out property <length> player-height: 84px;
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 8px;
    in-out property <length> radius-lg: 12px;
    in-out property <length> radius-pill: 20px;
}
