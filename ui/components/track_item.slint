import { Theme } from "../theme.slint";

export struct TrackData {
    id: string,
    title: string,
    artists: string,
    album: string,
    duration: string,
    is-liked: bool,
    explicit: bool,
    is-playing: bool,
}

export component TrackItem inherits Rectangle {
    in property <int> index: 1;
    in property <TrackData> track;
    callback clicked();
    callback like-toggled(string);

    height: 52px;
    border-radius: Theme.radius-sm;
    background: row-touch.has-hover ? #1F1F1F : #00000000;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        // Index / Play Icon
        Rectangle {
            width: 28px;

            if !row-touch.has-hover && !root.track.is-playing : Text {
                text: root.index;
                font-size: 13px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            if row-touch.has-hover || root.track.is-playing : Image {
                width: 14px;
                height: 14px;
                source: root.track.is-playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                colorize: root.track.is-playing ? Theme.accent : #FFFFFF;
                horizontal-alignment: center;
            }
        }

        // Title and Artists
        VerticalLayout {
            horizontal-stretch: 2;
            alignment: center;
            spacing: 2px;

            HorizontalLayout {
                spacing: 6px;

                Text {
                    text: root.track.title;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.track.is-playing ? Theme.accent : Theme.text-primary;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.track.explicit : Rectangle {
                    height: 14px;
                    border-radius: 2px;
                    background: #444444;

                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 3px;

                        Text {
                            text: "E";
                            font-size: 9px;
                            font-weight: 800;
                            color: #CCCCCC;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: root.track.artists;
                font-size: 11px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        // Album
        Text {
            horizontal-stretch: 1;
            text: root.track.album;
            font-size: 12px;
            color: Theme.text-secondary;
            overflow: elide;
            vertical-alignment: center;
        }

        // Like Button
        Rectangle {
            width: 24px;
            height: 24px;

            Image {
                width: 16px;
                height: 16px;
                source: root.track.is-liked ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                colorize: root.track.is-liked ? Theme.like-active : (like-touch.has-hover ? #FFFFFF : Theme.text-muted);
            }

            like-touch := TouchArea {
                clicked => { root.like-toggled(root.track.id); }
            }
        }

        // Duration
        Text {
            width: 44px;
            text: root.track.duration;
            font-size: 12px;
            color: Theme.text-secondary;
            horizontal-alignment: end;
            vertical-alignment: center;
        }
    }

    row-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
