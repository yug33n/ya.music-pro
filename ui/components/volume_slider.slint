import { Theme } from "../theme.slint";

export component VolumeSlider inherits Rectangle {
    in property <float> volume: 0.8; // 0.0 to 1.0
    in property <bool> is-muted: false;
    callback volume-changed(float);
    callback toggle-mute();

    width: 140px;
    height: 32px;

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        // Mute / Unmute button
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;

            Image {
                width: 18px;
                height: 18px;
                source: (root.is-muted || root.volume <= 0.01) ? @image-url("../icons/volume-mute.svg") : @image-url("../icons/volume.svg");
                colorize: mute-touch.has-hover ? #FFFFFF : Theme.text-secondary;
            }

            mute-touch := TouchArea {
                clicked => { root.toggle-mute(); }
            }
        }

        // Horizontal bar
        bar := Rectangle {
            horizontal-stretch: 1;
            height: slider-touch.has-hover ? 5px : 4px;
            border-radius: 2px;
            background: #333333;
            animate height { duration: 120ms; }

            // Active volume level
            Rectangle {
                x: 0;
                width: parent.width * (root.is-muted ? 0.0 : Math.max(0.0, Math.min(1.0, root.volume)));
                height: parent.height;
                border-radius: 2px;
                background: slider-touch.has-hover ? Theme.accent : #CCCCCC;
            }

            slider-touch := TouchArea {
                width: 100%;
                height: 24px;
                y: (parent.height - 24px) / 2;

                clicked => {
                    root.volume-changed(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                }

                moved => {
                    if (self.pressed) {
                        root.volume-changed(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                    }
                }
            }
        }
    }
}
