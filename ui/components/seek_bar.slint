import { Theme } from "../theme.slint";

export component SeekBar inherits Rectangle {
    in property <float> progress: 0.0; // 0.0 to 1.0
    in property <string> elapsed-text: "0:00";
    in property <string> duration-text: "0:00";
    callback seek-requested(float);

    height: 18px;

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        Text {
            text: root.elapsed-text;
            color: Theme.text-secondary;
            font-size: 11px;
            font-family: Theme.font-family-text;
            vertical-alignment: center;
        }

        track := Rectangle {
            horizontal-stretch: 1;
            height: touch-area.has-hover ? 6px : 4px;
            border-radius: 3px;
            background: #333333;
            animate height { duration: 150ms; }

            // Filled portion
            Rectangle {
                x: 0;
                width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                height: parent.height;
                border-radius: 3px;
                background: touch-area.has-hover ? Theme.accent : #FFFFFF;
                animate background { duration: 150ms; }
            }

            // Slider thumb on hover
            if touch-area.has-hover : Rectangle {
                x: parent.width * Math.max(0.0, Math.min(1.0, root.progress)) - 6px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #FFFFFF;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000088;
            }

            touch-area := TouchArea {
                width: 100%;
                height: 20px;
                y: (parent.height - 20px) / 2;

                clicked => {
                    root.seek-requested(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                }

                moved => {
                    if (self.pressed) {
                        root.seek-requested(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                    }
                }
            }
        }

        Text {
            text: root.duration-text;
            color: Theme.text-secondary;
            font-size: 11px;
            font-family: Theme.font-family-text;
            vertical-alignment: center;
        }
    }
}
