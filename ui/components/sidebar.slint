import { Theme } from "../theme.slint";

export component Sidebar inherits Rectangle {
    in property <int> active-tab: 0; // 0 = wave, 1 = collection, 2 = search, 3 = settings
    in property <string> user-name: "Гость";
    in property <bool> is-authorized: false;

    callback tab-selected(int);
    callback auth-clicked();

    width: Theme.sidebar-width;
    background: Theme.sidebar-background;

    // Right border line
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 24px;

        // Brand Logo
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Image {
                width: 32px;
                height: 32px;
                source: @image-url("../icons/logo.svg");
            }

            Text {
                text: "ya.music-pro";
                font-size: 18px;
                font-weight: 800;
                font-family: Theme.font-family-display;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // Navigation Items
        VerticalLayout {
            spacing: 6px;

            // 1. Моя волна
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: root.active-tab == 0 ? #252525 : (t0-touch.has-hover ? #1E1E1E : #00000000);
                animate background { duration: 100ms; }

                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 12px;
                    alignment: center;

                    Image {
                        width: 18px;
                        height: 18px;
                        source: @image-url("../icons/wave.svg");
                        colorize: root.active-tab == 0 ? Theme.accent : Theme.text-secondary;
                    }

                    Text {
                        text: "Моя волна";
                        font-size: 13px;
                        font-weight: root.active-tab == 0 ? 700 : 500;
                        color: root.active-tab == 0 ? #FFFFFF : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                t0-touch := TouchArea { clicked => { root.tab-selected(0); } }
            }

            // 2. Коллекция
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: root.active-tab == 1 ? #252525 : (t1-touch.has-hover ? #1E1E1E : #00000000);
                animate background { duration: 100ms; }

                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 12px;
                    alignment: center;

                    Image {
                        width: 18px;
                        height: 18px;
                        source: @image-url("../icons/library.svg");
                        colorize: root.active-tab == 1 ? Theme.accent : Theme.text-secondary;
                    }

                    Text {
                        text: "Коллекция";
                        font-size: 13px;
                        font-weight: root.active-tab == 1 ? 700 : 500;
                        color: root.active-tab == 1 ? #FFFFFF : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                t1-touch := TouchArea { clicked => { root.tab-selected(1); } }
            }

            // 3. Поиск
            Rectangle {
                height: 40px;
                border-radius: Theme.radius-md;
                background: root.active-tab == 2 ? #252525 : (t2-touch.has-hover ? #1E1E1E : #00000000);
                animate background { duration: 100ms; }

                HorizontalLayout {
                    padding-left: 14px;
                    spacing: 12px;
                    alignment: center;

                    Image {
                        width: 18px;
                        height: 18px;
                        source: @image-url("../icons/search.svg");
                        colorize: root.active-tab == 2 ? Theme.accent : Theme.text-secondary;
                    }

                    Text {
                        text: "Поиск";
                        font-size: 13px;
                        font-weight: root.active-tab == 2 ? 700 : 500;
                        color: root.active-tab == 2 ? #FFFFFF : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                t2-touch := TouchArea { clicked => { root.tab-selected(2); } }
            }
        }

        // Divider
        Rectangle {
            height: 1px;
            background: Theme.divider;
        }

        // Spacer
        Rectangle {
            vertical-stretch: 1;
        }

        // Bottom User & Auth section
        Rectangle {
            height: 52px;
            border-radius: Theme.radius-md;
            background: #202020;

            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.is-authorized ? Theme.accent : #333333;

                    Text {
                        text: root.is-authorized ? "Я" : "?";
                        font-size: 13px;
                        font-weight: 800;
                        color: root.is-authorized ? #121212 : #FFFFFF;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.user-name;
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        overflow: elide;
                    }

                    Text {
                        text: root.is-authorized ? "Авторизован" : "Войти через ya.ru";
                        font-size: 10px;
                        color: root.is-authorized ? #6BFF8A : Theme.accent;
                    }
                }
            }

            TouchArea {
                clicked => { root.auth-clicked(); }
            }
        }
    }
}
