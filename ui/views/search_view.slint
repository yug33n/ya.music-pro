import { Theme } from "../theme.slint";
import { TrackItem, TrackData } from "../components/track_item.slint";

export component SearchView inherits Flickable {
    in property <[TrackData]> results: [];
    in property <string> search-query: "";
    in property <bool> is-searching: false;

    callback query-changed(string);
    callback track-clicked(int);
    callback like-toggled(string);

    content-height: Math.max(700px, 160px + root.results.length * 54px);

    VerticalLayout {
        padding: 32px;
        spacing: 24px;

        // Search Input Bar
        Rectangle {
            height: 48px;
            border-radius: Theme.radius-pill;
            background: #202020;
            border-width: 1px;
            border-color: #333333;

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                alignment: center;

                Image {
                    width: 20px;
                    height: 20px;
                    source: @image-url("../icons/search.svg");
                    colorize: Theme.text-secondary;
                    vertical-alignment: center;
                }

                input := TextInput {
                    horizontal-stretch: 1;
                    text: root.search-query;
                    color: Theme.text-primary;
                    font-size: 14px;
                    font-family: Theme.font-family-text;
                    vertical-alignment: center;

                    edited => {
                        root.query-changed(self.text);
                    }
                }
            }
        }

        // Search status & results
        Text {
            text: root.search-query == "" ? "Введите название трека, исполнителя или альбома" : (root.is-searching ? "Поиск..." : "Результаты поиска (" + root.results.length + "):");
            font-size: 16px;
            font-weight: 700;
            color: Theme.text-secondary;
        }

        // Results list
        VerticalLayout {
            spacing: 2px;

            for track[idx] in root.results : TrackItem {
                index: idx + 1;
                track: track;
                clicked => { root.track-clicked(idx); }
                like-toggled(id) => { root.like-toggled(id); }
            }
        }
    }
}
