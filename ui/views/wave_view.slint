import { Theme } from "../theme.slint";
import { WaveWheel } from "../components/wave_wheel.slint";

export component WaveView inherits Flickable {
    in property <string> active-character: "favorite";
    in property <string> active-mood: "joyful";
    in property <string> active-language: "any";
    in property <bool> is-playing: false;

    callback play-wave-clicked();
    callback character-selected(string);
    callback mood-selected(string);
    callback language-selected(string);
    callback recommendation-clicked(string);

    viewport-height: 820px;

    VerticalLayout {
        padding: 32px;
        spacing: 36px;
        alignment: start;

        // 1. Header
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Моя волна";
                font-size: 32px;
                font-weight: 800;
                font-family: Theme.font-family-display;
                color: Theme.text-primary;
            }

            Text {
                text: "Персональный аудиопоток, который подстраивается под вас в реальном времени";
                font-size: 14px;
                font-family: Theme.font-family-text;
                color: Theme.text-secondary;
            }
        }

        // 2. Wave Wheel Hero Section
        HorizontalLayout {
            alignment: center;

            WaveWheel {
                active-character: root.active-character;
                active-mood: root.active-mood;
                active-language: root.active-language;
                is-playing: root.is-playing;

                character-selected(c) => { root.character-selected(c); }
                mood-selected(m) => { root.mood-selected(m); }
                language-selected(l) => { root.language-selected(l); }
                play-wave-clicked => { root.play-wave-clicked(); }
            }
        }

        // 3. Sub-filters: Mood & Language Row
        HorizontalLayout {
            alignment: center;
            spacing: 24px;

            // Mood Filter
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Настроение:";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-mood == "joyful" ? Theme.accent : #222222;
                    Text {
                        text: "Радостное";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-mood == "joyful" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.mood-selected("joyful"); } }
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-mood == "energetic" ? Theme.accent : #222222;
                    Text {
                        text: "Энергичное";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-mood == "energetic" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.mood-selected("energetic"); } }
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-mood == "sad" ? Theme.accent : #222222;
                    Text {
                        text: "Спокойное";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-mood == "sad" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.mood-selected("sad"); } }
                }
            }

            // Language Filter
            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Язык:";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-language == "any" ? Theme.accent : #222222;
                    Text {
                        text: "Любой";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-language == "any" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.language-selected("any"); } }
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-language == "russian" ? Theme.accent : #222222;
                    Text {
                        text: "Русский";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-language == "russian" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.language-selected("russian"); } }
                }

                Rectangle {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 10px;
                    border-radius: 14px;
                    background: root.active-language == "foreign" ? Theme.accent : #222222;
                    Text {
                        text: "Иностранный";
                        font-size: 12px;
                        font-weight: 600;
                        color: root.active-language == "foreign" ? #121212 : #FFFFFF;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.language-selected("foreign"); } }
                }
            }
        }

        // 4. "Для вас" Section
        VerticalLayout {
            spacing: 16px;

            Text {
                text: "Для вас";
                font-size: 20px;
                font-weight: 800;
                font-family: Theme.font-family-display;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: 16px;

                // Card 1: Плейлист дня
                Rectangle {
                    width: 170px;
                    height: 210px;
                    border-radius: Theme.radius-lg;
                    background: card1-touch.has-hover ? #282828 : Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 150ms; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Rectangle {
                            height: 120px;
                            border-radius: Theme.radius-md;
                            background: #E84E36;
                            Text {
                                text: "Плейлист\nдня";
                                font-size: 16px;
                                font-weight: 800;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Плейлист дня";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Каждый день новый";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }

                    card1-touch := TouchArea {
                        clicked => { root.recommendation-clicked("daily"); }
                    }
                }

                // Card 2: Премьера
                Rectangle {
                    width: 170px;
                    height: 210px;
                    border-radius: Theme.radius-lg;
                    background: card2-touch.has-hover ? #282828 : Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 150ms; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Rectangle {
                            height: 120px;
                            border-radius: Theme.radius-md;
                            background: #9B51E0;
                            Text {
                                text: "Премьера";
                                font-size: 16px;
                                font-weight: 800;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Премьера";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Свежие релизы";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }

                    card2-touch := TouchArea {
                        clicked => { root.recommendation-clicked("premiere"); }
                    }
                }

                // Card 3: Дежавю
                Rectangle {
                    width: 170px;
                    height: 210px;
                    border-radius: Theme.radius-lg;
                    background: card3-touch.has-hover ? #282828 : Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 150ms; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Rectangle {
                            height: 120px;
                            border-radius: Theme.radius-md;
                            background: #2D9CDB;
                            Text {
                                text: "Дежавю";
                                font-size: 16px;
                                font-weight: 800;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Дежавю";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Треки из прошлого";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }

                    card3-touch := TouchArea {
                        clicked => { root.recommendation-clicked("dejavu"); }
                    }
                }

                // Card 4: Тайник
                Rectangle {
                    width: 170px;
                    height: 210px;
                    border-radius: Theme.radius-lg;
                    background: card4-touch.has-hover ? #282828 : Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 150ms; }

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Rectangle {
                            height: 120px;
                            border-radius: Theme.radius-md;
                            background: #27AE60;
                            Text {
                                text: "Тайник";
                                font-size: 16px;
                                font-weight: 800;
                                color: #FFFFFF;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: "Тайник";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }

                        Text {
                            text: "Забытые фавориты";
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }

                    card4-touch := TouchArea {
                        clicked => { root.recommendation-clicked("cache"); }
                    }
                }
            }
        }
    }
}
