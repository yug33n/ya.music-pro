import { Theme } from "../theme.slint";
import { TrackItem, TrackData } from "../components/track_item.slint";

export component CollectionView inherits Flickable {
    in property <[TrackData]> tracks: [];
    in property <int> track-count: 0;

    callback play-all-clicked();
    callback track-clicked(int);
    callback like-toggled(string);

    content-height: Math.max(700px, 140px + root.tracks.length * 54px);

    VerticalLayout {
        padding: 32px;
        spacing: 24px;

        // Collection Header
        HorizontalLayout {
            spacing: 24px;
            alignment: center;

            // Big Heart Collection Badge
            Rectangle {
                width: 140px;
                height: 140px;
                border-radius: Theme.radius-lg;
                background: #FF334B;

                Image {
                    width: 64px;
                    height: 64px;
                    source: @image-url("../icons/heart.svg");
                    colorize: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Info
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 8px;

                Text {
                    text: "Плейлист";
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                }

                Text {
                    text: "Мне нравится";
                    font-size: 36px;
                    font-weight: 900;
                    font-family: Theme.font-family-display;
                    color: Theme.text-primary;
                }

                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;

                    Text {
                        text: root.track-count + " треков";
                        font-size: 13px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }

                    // Play All button
                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: play-touch.has-hover ? Theme.accent-hover : Theme.accent;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 8px;
                            alignment: center;

                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../icons/play.svg");
                                colorize: #121212;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "Слушать всё";
                                font-size: 13px;
                                font-weight: 800;
                                color: #121212;
                                vertical-alignment: center;
                            }
                        }

                        play-touch := TouchArea {
                            clicked => { root.play-all-clicked(); }
                        }
                    }
                }
            }
        }

        // Table Header
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                height: 24px;

                Text {
                    width: 28px;
                    text: "#";
                    font-size: 12px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                Text {
                    horizontal-stretch: 2;
                    text: "НАЗВАНИЕ";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                Text {
                    horizontal-stretch: 1;
                    text: "АЛЬБОМ";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }

                Text {
                    width: 70px;
                    text: "ВРЕМЯ";
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-muted;
                    horizontal-alignment: end;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }
        }

        // Tracks List
        VerticalLayout {
            spacing: 2px;

            for track[idx] in root.tracks : TrackItem {
                index: idx + 1;
                track: track;
                clicked => { root.track-clicked(idx); }
                like-toggled(id) => { root.like-toggled(id); }
            }

            if root.tracks.length == 0 : Rectangle {
                height: 120px;
                Text {
                    text: "В вашей коллекции пока нет треков";
                    font-size: 14px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
