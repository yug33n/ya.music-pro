import { Theme } from "../theme.slint";
import { SeekBar } from "../components/seek_bar.slint";

export struct LyricRow {
    timestamp_ms: int,
    text: string,
}

export component FullscreenView inherits Rectangle {
    in property <string> track-title: "Название трека";
    in property <string> track-artists: "Исполнитель";
    in property <image> track-cover;
    in property <bool> is-playing: false;
    in property <bool> is-liked: false;
    in property <float> seek-progress: 0.0;
    in property <string> elapsed-time: "0:00";
    in property <string> total-duration: "0:00";
    in property <[LyricRow]> lyrics: [];
    in property <int> active-line-index: -1;

    callback close-clicked();
    callback play-pause-clicked();
    callback prev-clicked();
    callback next-clicked();
    callback like-clicked();
    callback seek-requested(float);
    callback line-clicked(int); // timestamp in ms

    background: #0D0D10;

    // Ambient radial glow behind the poster
    Rectangle {
        x: 40px;
        y: (parent.height - 480px) / 2;
        width: 480px;
        height: 480px;
        border-radius: 240px;
        background: #FFCC0018;
    }

    VerticalLayout {
        padding: 28px;
        spacing: 20px;

        // Top Header with Close Button
        HorizontalLayout {
            height: 40px;
            alignment: space-between;

            // Brand / Title
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Image {
                    width: 24px;
                    height: 24px;
                    source: @image-url("../icons/wave.svg");
                    colorize: Theme.accent;
                }

                Text {
                    text: "Текст песни и караоке";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            // Close button (X)
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: close-touch.has-hover ? #2C2C32 : #1A1A20;
                animate background { duration: 120ms; }

                Text {
                    text: "✕";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                close-touch := TouchArea {
                    clicked => { root.close-clicked(); }
                }
            }
        }

        // Main Content: Left Column (Poster + Player) and Right Column (Lyrics)
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 48px;

            // 1. Left Column
            VerticalLayout {
                width: 380px;
                alignment: center;
                spacing: 24px;

                // Big Album Poster
                Rectangle {
                    width: 340px;
                    height: 340px;
                    border-radius: 16px;
                    background: #202026;
                    clip: true;
                    drop-shadow-blur: 24px;
                    drop-shadow-color: #000000AA;

                    if root.track-cover.width > 0 : Image {
                        width: 100%;
                        height: 100%;
                        source: root.track-cover;
                    }

                    if root.track-cover.width == 0 : Image {
                        width: 96px;
                        height: 96px;
                        source: @image-url("../icons/wave.svg");
                        colorize: #555555;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Track Title and Artist
                VerticalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.track-title;
                        font-size: 24px;
                        font-weight: 800;
                        font-family: Theme.font-family-display;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: root.track-artists;
                        font-size: 16px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                // Playback Controls
                HorizontalLayout {
                    alignment: center;
                    spacing: 24px;

                    // Like
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        Image {
                            width: 22px;
                            height: 22px;
                            source: root.is-liked ? @image-url("../icons/heart-filled.svg") : @image-url("../icons/heart.svg");
                            colorize: root.is-liked ? Theme.like-active : Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.like-clicked(); } }
                    }

                    // Prev
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        Image {
                            width: 22px;
                            height: 22px;
                            source: @image-url("../icons/prev.svg");
                            colorize: #FFFFFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.prev-clicked(); } }
                    }

                    // Play/Pause Big Button
                    Rectangle {
                        width: 48px;
                        height: 48px;
                        border-radius: 24px;
                        background: Theme.accent;

                        Image {
                            width: 24px;
                            height: 24px;
                            source: root.is-playing ? @image-url("../icons/pause.svg") : @image-url("../icons/play.svg");
                            colorize: #121212;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.play-pause-clicked(); } }
                    }

                    // Next
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        Image {
                            width: 22px;
                            height: 22px;
                            source: @image-url("../icons/next.svg");
                            colorize: #FFFFFF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.next-clicked(); } }
                    }
                }

                // SeekBar
                SeekBar {
                    progress: root.seek-progress;
                    elapsed-text: root.elapsed-time;
                    duration-text: root.total-duration;
                    seek-requested(p) => { root.seek-requested(p); }
                }
            }

            // 2. Right Column: Synced Karaoke Lyrics Scroller
            Flickable {
                horizontal-stretch: 1;
                content-height: Math.max(600px, 80px + root.lyrics.length * 64px);

                VerticalLayout {
                    padding-top: 100px;
                    padding-bottom: 200px;
                    spacing: 16px;

                    for row[idx] in root.lyrics : Rectangle {
                        height: idx == root.active-line-index ? 56px : 40px;
                        border-radius: Theme.radius-md;
                        background: lyric-touch.has-hover ? #25252A : #00000000;
                        animate height { duration: 200ms; }
                        animate background { duration: 150ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: start;

                            Text {
                                text: row.text;
                                font-size: idx == root.active-line-index ? 28px : 18px;
                                font-weight: idx == root.active-line-index ? 900 : (idx < root.active-line-index ? 600 : 500);
                                font-family: Theme.font-family-display;
                                color: idx == root.active-line-index ? #FFFFFF : (idx < root.active-line-index ? #888890 : #444450);
                                vertical-alignment: center;
                                overflow: elide;
                                animate font-size { duration: 200ms; }
                                animate color { duration: 200ms; }
                            }
                        }

                        lyric-touch := TouchArea {
                            clicked => {
                                root.line-clicked(row.timestamp_ms);
                            }
                        }
                    }

                    if root.lyrics.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: 12px;

                        Image {
                            width: 48px;
                            height: 48px;
                            source: @image-url("../icons/wave.svg");
                            colorize: #444450;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Для этого трека пока нет текста";
                            font-size: 18px;
                            color: #555560;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
