// Всплывающие окна: громкость, меню трека, настройки звука и эквалайзер.

import { Theme } from "theme.slint";
import { Icons, Icon } from "widgets.slint";
import { T, App, MenuEntry } from "state.slint";

// Вертикальный ползунок громкости над кнопкой: 44×216, радиус 24.
export component VolumePopup inherits Rectangle {
    in property <brush> fill: #1a1a1a;
    in property <brush> stroke: #4d4d4d;
    // Вариант волны: полупрозрачный, толстая полоса без бегунка.
    in property <bool> glass;
    out property <bool> hovered: ta.has-hover || ta.pressed;
    width: 44px;
    height: glass ? 210px : 216px;
    border-radius: glass ? 22px : 24px;
    background: glass ? #ffffff14 : fill;
    border-width: glass ? 0 : 1px;
    border-color: stroke;

    property <length> rail-y: glass ? 12px : 16px;
    property <length> rail-h: self.height - 2 * rail-y;
    property <length> rail-w: glass ? 8px : 4px;
    property <float> v: max(0, min(1, App.volume));

    Rectangle {
        x: (parent.width - rail-w) / 2;
        y: rail-y;
        width: rail-w;
        height: rail-h;
        border-radius: rail-w / 2;
        background: #ffffff1f;
    }
    Rectangle {
        x: (parent.width - rail-w) / 2;
        y: rail-y + rail-h * (1 - v);
        width: rail-w;
        height: rail-h * v;
        border-radius: rail-w / 2;
        background: glass ? #ffffffcc : ta.has-hover || ta.pressed ? Theme.controls-color-primary-default-enabled : #ffffffcc;
        animate background { duration: App.motion ? 150ms : 0ms; }
    }
    if !glass: Rectangle {
        x: (parent.width - 12px) / 2;
        y: rail-y + rail-h * (1 - v) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: ta.has-hover || ta.pressed ? Theme.controls-color-primary-default-enabled : #ffffff;
        animate background { duration: App.motion ? 150ms : 0ms; }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                App.set-volume(max(0, min(1, 1 - (self.mouse-y - root.rail-y) / root.rail-h)));
            }
        }
        moved => {
            if self.pressed {
                App.set-volume(max(0, min(1, 1 - (self.mouse-y - root.rail-y) / root.rail-h)));
            }
        }
        scroll-event(e) => {
            App.set-volume(max(0, min(1, App.volume + (e.delta-y > 0 ? 0.02 : -0.02))));
            accept
        }
    }
}

export component MenuRow inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> submenu;
    in property <bool> active;
    in property <bool> themed;
    callback clicked;
    callback hovered;
    property <brush> ink: themed ? Theme.controls-color-primary-text-enabled : #ffffff80;
    property <brush> ink-on: themed ? Theme.controls-color-primary-text-enabled-variant : #ffffffe6;
    height: 36px;
    border-radius: Theme.radius-size-m;
    background: ta.has-hover || active ? (themed ? Theme.surface-color-primary-enabled-list : #ffffff14) : transparent;
    animate background { duration: App.motion ? 150ms : 0ms; }
    if has-icon: Icon {
        x: 12px;
        source: icon;
        size: 20px;
        colorize: ta.has-hover || active ? ink-on : ink;
    }
    Text {
        x: has-icon ? 44px : 12px;
        width: parent.width - self.x - (submenu ? 36px : 12px);
        text: root.text;
        overflow: elide;
        font-size: Theme.font-size-label-m;
        font-weight: 500;
        color: ta.has-hover || active ? ink-on : ink;
        animate color { duration: App.motion ? 150ms : 0ms; }
    }
    if submenu: Icon {
        x: parent.width - 32px;
        source: Icons.arrow-right-small;
        size: 20px;
        colorize: ink;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover {
                root.hovered();
            }
        }
    }
}

// Меню трека: тёмная плашка с размытием, пункты 36 px, подменю справа.
export component TrackMenu inherits Rectangle {
    property <length> w: 275px;
    property <length> h: App.menu-items.length * 36px + 16px;
    property <length> mx: max(8px, min(App.menu-x - w / 2, root.width - w - 8px));
    property <length> my: App.menu-below
        ? (App.menu-y + 8px + h > root.height - 8px ? max(8px, App.menu-y - 48px - h) : App.menu-y + 8px)
        : App.menu-y - h - 8px < 8px ? min(App.menu-y + 28px, root.height - h - 8px) : App.menu-y - h - 8px;
    property <brush> fill: App.menu-themed ? Theme.background-color-primary-enabled-popover : #1f1f1ff2;
    property <color> shadow: App.menu-themed && !Theme.dark ? #00000029 : #0000007a;
    property <string> sid: App.submenu-open >= 0 && App.submenu-open < App.menu-items.length ? App.menu-items[App.submenu-open].id : "";
    property <bool> share: sid == "share" || sid == "list-share";

    function pick(id: string) {
        App.menu-open = false;
        App.submenu-open = -1;
        App.menu-action(id);
    }

    TouchArea {
        clicked => {
            App.menu-open = false;
            App.submenu-open = -1;
        }
        scroll-event(e) => {
            App.menu-open = false;
            accept
        }
    }

    box := Rectangle {
        x: mx;
        y: my;
        width: w;
        height: h;
        border-radius: 16px;
        background: fill;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: shadow;
        TouchArea { }
        for m[i] in App.menu-items: MenuRow {
            x: 8px;
            y: 8px + i * 36px;
            width: parent.width - 16px;
            text: m.text;
            icon: m.icon;
            submenu: m.submenu;
            themed: App.menu-themed;
            active: App.submenu-open == i;
            hovered => { App.submenu-open = m.submenu ? i : -1; }
            clicked => {
                if !m.submenu {
                    App.menu-open = false;
                    App.submenu-open = -1;
                    App.menu-action(m.id);
                }
            }
        }
    }

    if App.submenu-open >= 0: Rectangle {
        property <int> n: share ? 2 : App.menu-playlists.length;
        property <length> sh: min(n * 36px + 16px, 360px);
        x: box.x + w + 248px > root.width ? box.x - 248px : box.x + w - 4px;
        y: max(8px, min(box.y + 8px + App.submenu-open * 36px - 8px, root.height - sh - 8px));
        width: 252px;
        height: sh;
        border-radius: 16px;
        background: fill;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: shadow;
        TouchArea { }
        // «Поделиться»: ссылка или код для вставки на сайт.
        if share: MenuRow {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            text: T.t("Скопировать ссылку");
            icon: Icons.m-link;
            themed: App.menu-themed;
            clicked => { root.pick(root.sid + "-link"); }
        }
        if share: MenuRow {
            x: 8px;
            y: 44px;
            width: parent.width - 16px;
            text: T.t("HTML-код");
            icon: Icons.m-code;
            themed: App.menu-themed;
            clicked => { root.pick(root.sid + "-html"); }
        }
        if !share: Flickable {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            content-height: App.menu-playlists.length * 36px;
            for p[i] in App.menu-playlists: MenuRow {
                y: i * 36px;
                width: parent.width;
                text: p;
                has-icon: false;
                themed: App.menu-themed;
                clicked => {
                    App.menu-open = false;
                    App.submenu-open = -1;
                    App.menu-playlist(i);
                }
            }
        }
    }
}

component EqSlider inherits Rectangle {
    in property <float> value;
    in property <float> min-value: -12;
    in property <float> max-value: 12;
    in property <bool> enabled;
    callback changed(float);
    width: 13px;
    height: 144px;
    property <float> k: (value - min-value) / (max-value - min-value);
    Rectangle {
        x: 6px;
        width: 1px;
        background: Theme.controls-color-primary-default-disabled;
    }
    Rectangle {
        x: 2.5px;
        y: 72px;
        width: 8px;
        height: 1px;
        background: Theme.controls-color-primary-default-disabled;
    }
    Rectangle {
        x: -2px;
        y: (1 - k) * (root.height - 16px);
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: enabled ? Theme.controls-color-primary-default-enabled : Theme.controls-color-secondary-outline-enabled-stroke;
        background: Theme.background-color-secondary-enabled-blur;
    }
    TouchArea {
        x: -8px;
        width: 29px;
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.changed(root.min-value + (1 - max(0, min(1, (self.mouse-y - 8px) / (root.height - 16px)))) * (root.max-value - root.min-value));
            }
        }
        moved => {
            if self.pressed {
                root.changed(root.min-value + (1 - max(0, min(1, (self.mouse-y - 8px) / (root.height - 16px)))) * (root.max-value - root.min-value));
            }
        }
    }
}

component QualityItem inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> selected;
    callback clicked;
    background: ta.has-hover ? Theme.surface-color-primary-enabled-list : transparent;
    animate background { duration: App.motion ? 150ms : 0ms; }
    Text {
        x: 25px;
        y: 12px;
        text: root.title;
        font-size: Theme.font-size-label-s;
        font-weight: 500;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    Text {
        x: 25px;
        y: 34px;
        width: 356px;
        text: root.subtitle;
        wrap: word-wrap;
        font-size: Theme.font-size-label-xs;
        font-weight: 500;
        color: Theme.controls-color-primary-text-enabled;
    }
    if selected: Icon {
        x: parent.width - 44px;
        y: (parent.height - 20px) / 2;
        source: Icons.check;
        size: 20px;
        colorize: Theme.controls-color-primary-text-enabled-variant;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// «Настройки звука»: качество и эквалайзер, окно оригинала 430×612.
export component SoundSettings inherits Rectangle {
    width: 430px;
    height: 353px + eq-block.height;
    border-radius: 16px;
    background: Theme.background-color-primary-enabled-popover;
    border-width: 1px;
    border-color: Theme.outline-color-primary-disabled;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.dark ? #0000007a : #0000003d;
    property <bool> presets-open;
    TouchArea { }

    Text {
        x: 21px;
        y: 26px;
        text: T.t("Настройки звука");
        font-family: "YS Music Headline";
        font-size: Theme.font-size-headline-xs;
        font-weight: 700;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    Rectangle {
        x: 377px;
        y: 21px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: close-ta.has-hover ? Theme.controls-color-secondary-default-hovered : Theme.controls-color-secondary-default-enabled;
        animate background { duration: App.motion ? 150ms : 0ms; }
        Icon { source: Icons.close-small; size: 20px; colorize: Theme.controls-color-primary-text-enabled-variant; }
        close-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { App.eq-open = false; }
        }
    }

    QualityItem {
        x: 1px;
        y: 69px;
        width: 428px;
        height: 82px;
        title: T.t("Превосходное");
        subtitle: T.t("Музыка в lossless и других высококачественных форматах для быстрого интернета и хорошей акустики");
        selected: App.quality == 0;
        clicked => { App.set-quality(0); }
    }
    QualityItem {
        x: 1px;
        y: 151px;
        width: 428px;
        height: 64px;
        title: T.t("Оптимальное");
        subtitle: T.t("Сбалансированный звук для большинства устройств");
        selected: App.quality == 1;
        clicked => { App.set-quality(1); }
    }
    QualityItem {
        x: 1px;
        y: 215px;
        width: 428px;
        height: 64px;
        title: T.t("Экономичное");
        subtitle: T.t("Стабильное звучание при медленном интернете");
        selected: App.quality == 2;
        clicked => { App.set-quality(2); }
    }

    Text {
        x: 25px;
        y: 303px;
        text: T.t("Эквалайзер");
        font-size: Theme.font-size-label-l;
        font-weight: 500;
        color: Theme.controls-color-primary-text-enabled-variant;
    }
    Rectangle {
        x: 373px;
        y: 305px;
        width: 32px;
        height: 20px;
        border-radius: 10px;
        background: App.eq-on ? Theme.controls-color-primary-default-enabled : Theme.controls-color-primary-default-disabled;
        animate background { duration: App.motion ? Theme.duration-transition : 0ms; }
        Rectangle {
            x: App.eq-on ? 14px : 2px;
            animate x { duration: App.motion ? Theme.duration-transition : 0ms; }
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: App.eq-on ? #000000 : (Theme.dark ? #e6e6e6 : #ffffff);
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                root.presets-open = false;
                App.eq-toggle();
            }
        }
    }

    // Как у оригинала: выключенный эквалайзер сворачивается за 0,2 с, окно становится ниже.
    eq-block := Rectangle {
        y: 325px;
        height: App.eq-on ? 259px : 0;
        clip: true;
        opacity: App.eq-on ? 1 : 0;
        animate height, opacity { duration: App.motion ? 200ms : 0ms; }

        EqSlider {
            x: 36px;
            y: 18px;
            min-value: 0.5;
            max-value: 1.5;
            value: App.eq-preamp;
            enabled: App.eq-on;
            changed(v) => { App.eq-set-preamp(v); }
        }
        Text { x: 66px; y: 18px; text: "12dB"; font-size: Theme.font-size-label-xs; color: Theme.controls-color-primary-text-enabled; }
        Text { x: 66px; y: 81px; text: "0dB"; font-size: Theme.font-size-label-xs; color: Theme.controls-color-primary-text-enabled; }
        Text { x: 66px; y: 144px; text: "-12dB"; font-size: Theme.font-size-label-xs; color: Theme.controls-color-primary-text-enabled; }
        Text { x: 25px; y: 170px; text: T.t("уровень"); font-size: Theme.font-size-label-xs; color: Theme.controls-color-primary-text-enabled; }

        for g[i] in App.eq-gains: Rectangle {
            x: 119px + i * 29.3px;
            y: 18px;
            width: 13px;
            height: 170px;
            EqSlider {
                y: 0;
                value: g;
                enabled: App.eq-on;
                changed(v) => { App.eq-set-band(i, v); }
            }
            Text {
                y: 152px;
                x: (13px - self.preferred-width) / 2;
                text: i == 0 ? "60" : i == 1 ? "170" : i == 2 ? "310" : i == 3 ? "600" : i == 4 ? "1k" : i == 5 ? "3k" : i == 6 ? "6k" : i == 7 ? "12k" : i == 8 ? "14k" : "16k";
                font-size: Theme.font-size-label-xs;
                color: Theme.controls-color-primary-text-enabled;
            }
        }

        Rectangle {
            x: 25px;
            y: 211px;
            width: 380px;
            height: 48px;
            border-radius: 24px;
            border-width: 1px;
            border-color: App.eq-on ? (dd-ta.has-hover ? Theme.controls-color-secondary-outline-hovered-stroke : Theme.controls-color-secondary-outline-enabled-stroke) : Theme.controls-color-secondary-outline-disabled-stroke;
            animate border-color { duration: App.motion ? 150ms : 0ms; }
            Text {
                x: 20px;
                text: App.eq-presets[App.eq-preset];
                font-size: Theme.font-size-label-m;
                font-weight: 500;
                color: App.eq-on ? Theme.controls-color-primary-text-enabled-variant : Theme.controls-color-primary-text-disabled;
            }
            Icon {
                x: parent.width - 40px;
                source: Icons.arrow-down;
                size: 20px;
                colorize: App.eq-on ? Theme.controls-color-primary-text-enabled-variant : Theme.controls-color-primary-text-disabled;
            }
            dd-ta := TouchArea {
                enabled: App.eq-on;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.presets-open = !root.presets-open; }
            }
        }
    }

    if presets-open: Rectangle {
        x: 25px;
        y: 536px - self.height - 4px;
        width: 380px;
        height: min(App.eq-presets.length * 36px + 16px, 420px);
        border-radius: 16px;
        background: Theme.background-color-primary-enabled-popover;
        border-width: 1px;
        border-color: Theme.outline-color-primary-disabled;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.dark ? #0000007a : #0000003d;
        TouchArea { }
        Flickable {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            content-height: App.eq-presets.length * 36px;
            for p[i] in App.eq-presets: MenuRow {
                y: i * 36px;
                width: parent.width;
                text: p;
                themed: true;
                has-icon: false;
                active: i == App.eq-preset;
                clicked => {
                    root.presets-open = false;
                    App.eq-select-preset(i);
                }
            }
        }
    }
}
